import sqlite3

def connect():
    return sqlite3.connect("notes.db")

def create_table():
    connection = connect()
    cursor = connection.cursor

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS notes (
                   id INTEGER PRIMARY KEY AUTOINCREMENT,
                    title TEXT NOT NULL,                  
                   content TEXT NOT NULL,
                   created_at TEXT NOT NULL
        )
    """
    )

    connection.commit
    connection.close